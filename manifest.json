{
  "manifest_version": 3,
  "name": "YT profile pic viewer",
  "version": "1.2",
  "description": "Shows a user's full size profile picture when hovering over a YouTube comment's preview image",
  "icons": {
    "16": "icon/Y_16.png",
    "32": "icon/Y_32.png",
    "128": "icon/Y_128.png",
    "512": "icon/Y_512.png"
  },
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icon/Y_16.png",
      "32": "icon/Y_32.png",
      "128": "icon/Y_128.png",
      "512": "icon/Y_512.png"
    },
    "default_title": "YT Profile Pic Viewer"
  }
}
